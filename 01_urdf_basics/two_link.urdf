<?xml version="1.0"?>
<robot name="two_link">
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <mass value="1.0"/>
            <inertia ixx="0.01417" ixy="0.0" ixz="0.0" iyy="0.01417" iyz="0.0" izz="0.02667"/>
        </inertial>
    </link>
    <link name="arm_link">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.5"/>
            </geometry>
            <material name="blue">
                <color rgba="0.2 0.4 0.9 1"/>
            </material>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.5"/>
            </geometry>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
        </collision>
        <inertial>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <mass value="0.3"/>
            <inertia ixx="0.006318" ixy="0.0" ixz="0.0" iyy="0.006318" iyz="0.0" izz="0.000135"/>
        </inertial>
    </link>
    <joint name="arm_joint" type="revolute">
        <parent link="base_link"/>
        <child link="arm_link"/>
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10.0" velocity="1.0"/>
    </joint>
</robot>