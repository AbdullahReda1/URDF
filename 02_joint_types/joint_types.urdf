<?xml version="1.0"?>
<robot name="joint_types_demo">
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.4 0.4 0.1"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="1.0"/>
            <inertia ixx="0.01417" iyy="0.01417" izz="0.02667" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="arm_link">
        <visual>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <box size="0.03 0.03 0.3"/>
            </geometry>
            <material name="blue">
                <color rgba="0.2 0.4 0.9 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.15"/>
            <geometry>
                <box size="0.03 0.03 0.3"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.15"/>
            <mass value="0.2"/>
            <inertia ixx="0.0015" iyy="0.0015" izz="0.00003" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="wheel_link">
        <visual>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <origin rpy="1.5708 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.02"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.0000158" iyy="0.0000125" izz="0.0000158" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="lift_link">
        <visual>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
            <material name="green">
                <color rgba="0.2 0.8 0.2 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.1 0.1 0.05"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="sensor_link">
        <visual>
            <geometry>
                <box size="0.04 0.04 0.04"/>
            </geometry>
            <material name="red">
                <color rgba="0.9 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.04 0.04 0.04"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.0000133" iyy="0.0000133" izz="0.0000133" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <joint name="lift_joint" type="prismatic">
        <parent link="base_link"/>
        <child link="lift_link"/>
        <origin xyz="0.15 -0.15 0.05"/>
        <axis xyz="0.0 0.0 1"/>
        <limit lower="0.0" upper="0.3" effort="10" velocity="0.5"/>
    </joint>
    <joint name="sensor_joint" type="fixed">
        <parent link="base_link"/>
        <child link="sensor_link"/>
        <origin xyz="-0.15 -0.15 0.07"/>
    </joint>
    <joint name="arm_joint" type="revolute">
        <parent link="base_link"/>
        <child link="arm_link"/>
        <origin xyz="0.15 0.15 0.05"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
    </joint>
    <joint name="wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="wheel_link"/>
        <origin xyz="0.15 -0.15 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    <link name="planar_dummy_x">
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="planar_dummy_y">
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="planar_link">
        <visual>
            <geometry>
                <box size="0.08 0.08 0.02"/>
            </geometry>
            <material name="orange">
                <color rgba="0.9 0.5 0.1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="0.08 0.08 0.02"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.0000375" iyy="0.0000375" izz="0.0000667" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <joint name="planar_x_joint" type="prismatic">
        <parent link="base_link"/>
        <child link="planar_dummy_x"/>
        <origin xyz="0 0 0.2"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.2" upper="0.2" effort="10" velocity="0.5"/>
    </joint>
    <joint name="planar_y_joint" type="prismatic">
        <parent link="planar_dummy_x"/>
        <child link="planar_dummy_y"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.2" upper="0.2" effort="10" velocity="0.5"/>
    </joint>
    <joint name="planar_yaw_joint" type="revolute">
        <parent link="planar_dummy_y"/>
        <child link="planar_link"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    </joint>
    <link name="floating_dummy_x">
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="floating_dummy_y">
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="floating_dummy_z">
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="floating_dummy_roll">
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="floating_dummy_pitch">
        <inertial>
            <mass value="0.001"/>
            <inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <link name="floating_link">
        <visual>
            <geometry>
                <sphere radius="0.04"/>
            </geometry>
            <material name="purple">
                <color rgba="0.6 0.2 0.8 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.000032" iyy="0.000032" izz="0.000032" ixy="0" ixz="0" iyz="0"/>
        </inertial>
    </link>
    <joint name="floating_x_joint" type="prismatic">
        <parent link="base_link"/>
        <child link="floating_dummy_x"/>
        <origin xyz="0 0.3 0.2"/>
        <axis xyz="1 0 0"/>
        <limit lower="-0.2" upper="0.2" effort="10" velocity="0.5"/>
    </joint>
    <joint name="floating_y_joint" type="prismatic">
        <parent link="floating_dummy_x"/>
        <child link="floating_dummy_y"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-0.2" upper="0.2" effort="10" velocity="0.5"/>
    </joint>
    <joint name="floating_z_joint" type="prismatic">
        <parent link="floating_dummy_y"/>
        <child link="floating_dummy_z"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-0.2" upper="0.2" effort="10" velocity="0.5"/>
    </joint>
    <joint name="floating_roll_joint" type="revolute">
        <parent link="floating_dummy_z"/>
        <child link="floating_dummy_roll"/>
        <origin xyz="0 0 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    </joint>
    <joint name="floating_pitch_joint" type="revolute">
        <parent link="floating_dummy_roll"/>
        <child link="floating_dummy_pitch"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    </joint>
    <joint name="floating_yaw_joint" type="revolute">
        <parent link="floating_dummy_pitch"/>
        <child link="floating_link"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
    </joint>
</robot>